{
  "$schema": "https://raw.githubusercontent.com/TabularisDB/tabularis/main/src/schemas/theme-definition-v1.json",
  "schemaVersion": 1,
  "mode": "dark",
  "attribution": "Breadbin 64 by Andrea Debernardi. Sixteen-color 1982 home computer palette on the classic blue screen with a lighter border. MIT licensed.",
  "colors": {
    "bg": {
      "base": "#352879",
      "elevated": "#2c2166",
      "overlay": "#000000",
      "input": "#2c2166",
      "tooltip": "#2c2166"
    },
    "surface": {
      "primary": "#352879",
      "secondary": "#40318d",
      "tertiary": "#4a3a9a",
      "hover": "#40318d",
      "active": "#6657b2",
      "disabled": "#2c2166"
    },
    "text": {
      "primary": "#e6e2ff",
      "secondary": "#a9a0e8",
      "muted": "#a198de",
      "disabled": "#4938af",
      "accent": "#aaffee",
      "inverse": "#000000"
    },
    "accent": {
      "primary": "#7869c4",
      "secondary": "#aaffee",
      "success": "#00cc55",
      "warning": "#eeee77",
      "error": "#ff9595",
      "info": "#6bbbff"
    },
    "border": {
      "subtle": "#4a3a9a",
      "default": "#8274c8",
      "strong": "#aaffee",
      "focus": "#ffffff"
    },
    "semantic": {
      "string": "#eeee77",
      "number": "#aaffee",
      "boolean": "#e278e2",
      "date": "#aaff66",
      "null": "#a0a0a0",
      "primaryKey": "#de8a58",
      "foreignKey": "#5aaeff",
      "index": "#ffb7ff",
      "modified": "#ffff66",
      "deleted": "#edaded",
      "new": "#00d057"
    }
  },
  "typography": {
    "fontFamily": {
      "base": [
        "C64 Pro",
        "Press Start 2P",
        "Verdana",
        "sans-serif"
      ],
      "mono": [
        "C64 Pro Mono",
        "Press Start 2P",
        "Courier New",
        "monospace"
      ]
    }
  },
  "layout": {
    "borderRadius": {
      "sm": 0,
      "base": 0,
      "lg": 0,
      "xl": 0
    }
  },
  "editor": {
    "colors": {
      "editor.background": "#352879",
      "editor.foreground": "#e6e2ff",
      "editor.lineHighlightBackground": "#2c2166",
      "editor.selectionBackground": "#6657b2",
      "editor.inactiveSelectionBackground": "#40318d",
      "editor.selectionHighlightBackground": "#4a3a9a",
      "editorCursor.foreground": "#8274c8",
      "editorLineNumber.foreground": "#a198de",
      "editorLineNumber.activeForeground": "#a9a0e8",
      "editorIndentGuide.background": "#4a3a9a",
      "editorIndentGuide.activeBackground": "#8274c8",
      "editorBracketMatch.border": "#ffffff",
      "editorBracketMatch.background": "#4a3a9a",
      "editorWidget.background": "#2c2166",
      "editorWidget.border": "#8274c8",
      "editorSuggestWidget.background": "#2c2166",
      "editorSuggestWidget.selectedBackground": "#40318d",
      "editorSuggestWidget.border": "#8274c8",
      "editorHoverWidget.background": "#2c2166",
      "editorHoverWidget.border": "#8274c8",
      "editor.findMatchBackground": "#68680d",
      "editor.findMatchHighlightBackground": "#444408",
      "editor.wordHighlightBackground": "#40318d",
      "editorWhitespace.foreground": "#8274c8",
      "scrollbarSlider.background": "#8274c899",
      "scrollbarSlider.hoverBackground": "#aaffeeaa",
      "editorError.foreground": "#ff9595",
      "editorWarning.foreground": "#eeee77"
    },
    "rules": [
      {
        "token": "keyword",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.sql",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.block",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.block.sql",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.choice",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.choice.sql",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.try",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.try.sql",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.catch",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.catch.sql",
        "foreground": "#aaffee",
        "fontStyle": "bold"
      },
      {
        "token": "string",
        "foreground": "#eeee77"
      },
      {
        "token": "string.sql",
        "foreground": "#eeee77"
      },
      {
        "token": "string.quote",
        "foreground": "#eeee77"
      },
      {
        "token": "string.quote.sql",
        "foreground": "#eeee77"
      },
      {
        "token": "number",
        "foreground": "#aaff66"
      },
      {
        "token": "number.sql",
        "foreground": "#aaff66"
      },
      {
        "token": "comment",
        "foreground": "#a9a0e8",
        "fontStyle": "italic"
      },
      {
        "token": "comment.sql",
        "foreground": "#a9a0e8",
        "fontStyle": "italic"
      },
      {
        "token": "comment.quote",
        "foreground": "#a9a0e8",
        "fontStyle": "italic"
      },
      {
        "token": "comment.quote.sql",
        "foreground": "#a9a0e8",
        "fontStyle": "italic"
      },
      {
        "token": "operator",
        "foreground": "#ffffff"
      },
      {
        "token": "operator.sql",
        "foreground": "#ffffff"
      },
      {
        "token": "delimiter",
        "foreground": "#bbbbbb"
      },
      {
        "token": "delimiter.sql",
        "foreground": "#bbbbbb"
      },
      {
        "token": "delimiter.parenthesis",
        "foreground": "#bbbbbb"
      },
      {
        "token": "delimiter.parenthesis.sql",
        "foreground": "#bbbbbb"
      },
      {
        "token": "delimiter.square",
        "foreground": "#bbbbbb"
      },
      {
        "token": "delimiter.square.sql",
        "foreground": "#bbbbbb"
      },
      {
        "token": "identifier",
        "foreground": "#e6e2ff"
      },
      {
        "token": "identifier.sql",
        "foreground": "#e6e2ff"
      },
      {
        "token": "identifier.quote",
        "foreground": "#e278e2"
      },
      {
        "token": "identifier.quote.sql",
        "foreground": "#e278e2"
      },
      {
        "token": "predefined",
        "foreground": "#5cb0ff"
      },
      {
        "token": "predefined.sql",
        "foreground": "#5cb0ff"
      },
      {
        "token": "invalid",
        "foreground": "#ff7777",
        "fontStyle": "underline"
      },
      {
        "token": "invalid.sql",
        "foreground": "#ff7777",
        "fontStyle": "underline"
      }
    ]
  }
}
