{
  "$schema": "https://raw.githubusercontent.com/TabularisDB/tabularis/main/src/schemas/theme-definition-v1.json",
  "schemaVersion": 1,
  "mode": "dark",
  "attribution": "Hot Dog Stand by Andrea Debernardi. Ketchup, mustard and black, after the infamous 1992 desktop scheme. MIT licensed.",
  "colors": {
    "bg": {
      "base": "#9c0000",
      "elevated": "#9c0000",
      "overlay": "#000000",
      "input": "#800000",
      "tooltip": "#800000"
    },
    "surface": {
      "primary": "#9c0000",
      "secondary": "#8c0000",
      "tertiary": "#7a0000",
      "hover": "#8c0000",
      "active": "#520000",
      "disabled": "#7a0000"
    },
    "text": {
      "primary": "#ffff00",
      "secondary": "#ffffff",
      "muted": "#ffd9b3",
      "disabled": "#e06060",
      "accent": "#ffff00",
      "inverse": "#000000"
    },
    "accent": {
      "primary": "#ffff00",
      "secondary": "#ffffff",
      "success": "#9dff9d",
      "warning": "#ffff00",
      "error": "#ffffff",
      "info": "#9deeff"
    },
    "border": {
      "subtle": "#000000",
      "default": "#e6b800",
      "strong": "#ffff00",
      "focus": "#ffff00"
    },
    "semantic": {
      "string": "#ffffff",
      "number": "#ffff00",
      "boolean": "#ffd9b3",
      "date": "#ffffff",
      "null": "#ffb2d8",
      "primaryKey": "#f2f200",
      "foreignKey": "#f4f4f4",
      "index": "#7de8ff",
      "modified": "#fcfc00",
      "deleted": "#ffddee",
      "new": "#00e600"
    }
  },
  "typography": {
    "fontFamily": {
      "base": [
        "MS Sans Serif",
        "Tahoma",
        "Arial",
        "sans-serif"
      ],
      "mono": [
        "Courier New",
        "Courier",
        "monospace"
      ]
    }
  },
  "layout": {
    "borderRadius": {
      "sm": 0,
      "base": 0,
      "lg": 0,
      "xl": 0
    }
  },
  "editor": {
    "colors": {
      "editor.background": "#9c0000",
      "editor.foreground": "#ffff00",
      "editor.lineHighlightBackground": "#9c0000",
      "editor.selectionBackground": "#520000",
      "editor.inactiveSelectionBackground": "#8c0000",
      "editor.selectionHighlightBackground": "#7a0000",
      "editorCursor.foreground": "#ffff00",
      "editorLineNumber.foreground": "#ffd9b3",
      "editorLineNumber.activeForeground": "#ffffff",
      "editorIndentGuide.background": "#000000",
      "editorIndentGuide.activeBackground": "#e6b800",
      "editorBracketMatch.border": "#ffff00",
      "editorBracketMatch.background": "#7a0000",
      "editorWidget.background": "#9c0000",
      "editorWidget.border": "#e6b800",
      "editorSuggestWidget.background": "#9c0000",
      "editorSuggestWidget.selectedBackground": "#8c0000",
      "editorSuggestWidget.border": "#e6b800",
      "editorHoverWidget.background": "#9c0000",
      "editorHoverWidget.border": "#e6b800",
      "editor.findMatchBackground": "#757500",
      "editor.findMatchHighlightBackground": "#4c4c00",
      "editor.wordHighlightBackground": "#8c0000",
      "editorWhitespace.foreground": "#e6b800",
      "scrollbarSlider.background": "#e6b80099",
      "scrollbarSlider.hoverBackground": "#ffff00aa",
      "editorError.foreground": "#ffffff",
      "editorWarning.foreground": "#ffff00"
    },
    "rules": [
      {
        "token": "keyword",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.sql",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.block",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.block.sql",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.choice",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.choice.sql",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.try",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.try.sql",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.catch",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "keyword.catch.sql",
        "foreground": "#ffffff",
        "fontStyle": "bold"
      },
      {
        "token": "string",
        "foreground": "#ffff00"
      },
      {
        "token": "string.sql",
        "foreground": "#ffff00"
      },
      {
        "token": "string.quote",
        "foreground": "#ffff00"
      },
      {
        "token": "string.quote.sql",
        "foreground": "#ffff00"
      },
      {
        "token": "number",
        "foreground": "#ffff00"
      },
      {
        "token": "number.sql",
        "foreground": "#ffff00"
      },
      {
        "token": "comment",
        "foreground": "#ffd9b3",
        "fontStyle": "italic"
      },
      {
        "token": "comment.sql",
        "foreground": "#ffd9b3",
        "fontStyle": "italic"
      },
      {
        "token": "comment.quote",
        "foreground": "#ffd9b3",
        "fontStyle": "italic"
      },
      {
        "token": "comment.quote.sql",
        "foreground": "#ffd9b3",
        "fontStyle": "italic"
      },
      {
        "token": "operator",
        "foreground": "#ffffff"
      },
      {
        "token": "operator.sql",
        "foreground": "#ffffff"
      },
      {
        "token": "delimiter",
        "foreground": "#ffd9b3"
      },
      {
        "token": "delimiter.sql",
        "foreground": "#ffd9b3"
      },
      {
        "token": "delimiter.parenthesis",
        "foreground": "#ffd9b3"
      },
      {
        "token": "delimiter.parenthesis.sql",
        "foreground": "#ffd9b3"
      },
      {
        "token": "delimiter.square",
        "foreground": "#ffd9b3"
      },
      {
        "token": "delimiter.square.sql",
        "foreground": "#ffd9b3"
      },
      {
        "token": "identifier",
        "foreground": "#ffff00"
      },
      {
        "token": "identifier.sql",
        "foreground": "#ffff00"
      },
      {
        "token": "identifier.quote",
        "foreground": "#ffffff"
      },
      {
        "token": "identifier.quote.sql",
        "foreground": "#ffffff"
      },
      {
        "token": "predefined",
        "foreground": "#ffffff"
      },
      {
        "token": "predefined.sql",
        "foreground": "#ffffff"
      },
      {
        "token": "invalid",
        "foreground": "#9deeff",
        "fontStyle": "underline"
      },
      {
        "token": "invalid.sql",
        "foreground": "#9deeff",
        "fontStyle": "underline"
      }
    ]
  }
}
